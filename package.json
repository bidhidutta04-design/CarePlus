{
  "name": "careplus-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CarePlus HMS — frontend (Next.js) + backend (Express REST API) monorepo",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @careplus/backend\" \"npm run dev -w @careplus/frontend\"",
    "dev:frontend": "npm run dev -w @careplus/frontend",
    "dev:backend": "npm run dev -w @careplus/backend",
    "build": "npm run build -w @careplus/backend && npm run build -w @careplus/frontend",
    "build:frontend": "npm run build -w @careplus/frontend",
    "build:backend": "npm run build -w @careplus/backend",
    "typecheck": "npm run typecheck -w @careplus/backend && npm run typecheck -w @careplus/frontend",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint -w @careplus/backend",
    "start:backend": "npm run start -w @careplus/backend",
    "start:frontend": "npm run start -w @careplus/frontend",
    "prepare": "husky"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6"
  },
  "lint-staged": {
    "backend/**/*.{ts,js,cjs,mjs,json,md}": [
      "prettier --write",
      "eslint --fix --config backend/eslint.config.mjs"
    ],
    "*.{json,md,cjs,yml,yaml}": [
      "prettier --write"
    ]
  }
}
