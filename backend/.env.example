# Server
PORT=4000
FRONTEND_URL=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/careplus
# Use: mongodb+srv://user:pass@cluster.mongodb.net/careplus?appName=Cluster0 for Atlas

# Auth — access token (short) + refresh token (long)
JWT_SECRET=change-me-in-production-min-32-chars-at-least-48-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
